{
    "env": {
        "es2020": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:prettier/recommended"
    ],
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "script"
    },
    "rules": {
        "no-var": "off",
        "prefer-const": "warn",
        "eqeqeq": [
            "error",
            "always"
        ],
        "no-trailing-spaces": "error",
        "no-multiple-empty-lines": [
            "error",
            {
                "max": 1
            }
        ]
    },
    "ignorePatterns": [
        "node_modules/",
        "coverage/",
        "dist/"
    ]
}