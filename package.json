{
  "name": "convert-units",
  "version": "2.5.2",
  "description": "Convert between quantities in different units",
  "main": "lib",
  "dependencies": {
    "lodash.keys": "2.3.x",
    "lodash.foreach": "2.3.x"
  },
  "devDependencies": {
    "assert-diff": "^1.1.0",
    "jake": "8.0.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3"
  },
  "scripts": {
    "test": "jake test --trace",
    "lint": "eslint lib --ext .js",
    "format": "prettier --write lib test *.json",
    "format:check": "prettier --check lib test *.json",
    "ci:lint": "eslint lib --ext .js && prettier --check lib test *.json",
    "check:collisions": "node scripts/check-collisions.js",
    "build:registry": "node scripts/gen-registry.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/your-org/convert-units.git"
  },
  "keywords": [
    "metric",
    "imperial",
    "convert",
    "ratio",
    "fraction"
  ],
  "author": "H Pandala",
  "license": "MIT"
}
